{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Visao Executiva - Todos os Microsservicos (SolidaryTech)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    { "title": "Golden Metrics (Donation)", "url": "/d/solidarytech-golden-metrics", "type": "link" },
    { "title": "SLO Tracking", "url": "/d/solidarytech-slo-tracking", "type": "link" },
    { "title": "DR Status", "url": "/d/solidarytech-dr-status", "type": "link" }
  ],
  "panels": [
    {
      "title": "",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Regiao Ativa",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "description": "Regiao onde os servicos estao rodando. us-east-1 = Producao. us-west-2 = DR.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [
            { "type": "value", "options": { "us-east-1": { "text": "PRODUCAO (us-east-1)", "color": "green" } } },
            { "type": "value", "options": { "us-west-2": { "text": "DR (us-west-2)", "color": "orange" } } }
          ]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "expr": "label_replace(count(up{namespace=\"solidarytech\"} == 1), \"__name__\", \"$1\", \"topology_kubernetes_io_region\", \"(.+)\") * 0 + on() group_left(topology_kubernetes_io_region) topk(1, count by (topology_kubernetes_io_region) (up{namespace=\"solidarytech\"} == 1))", "legendFormat": "{{ topology_kubernetes_io_region }}", "refId": "A" }
      ]
    },
    {
      "title": "Status dos Servicos",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 4, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "orientation": "horizontal" },
      "targets": [
        { "expr": "up{app=\"ngo-service\", namespace=\"solidarytech\"}", "legendFormat": "NGO Service", "refId": "A" },
        { "expr": "up{app=\"donation-service\", namespace=\"solidarytech\"}", "legendFormat": "Donation Service", "refId": "B" },
        { "expr": "up{app=\"volunteer-service\", namespace=\"solidarytech\"}", "legendFormat": "Volunteer Service", "refId": "C" }
      ]
    },
    {
      "title": "Total de Pods Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 2 }, { "color": "green", "value": 3 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "expr": "count(up{namespace=\"solidarytech\"} == 1)", "legendFormat": "Running", "refId": "A" }
      ]
    },
    {
      "title": "Restarts (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"solidarytech\"}[1h]))", "legendFormat": "Restarts", "refId": "A" }
      ]
    },
    {
      "title": "Alertas Ativos",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "expr": "count(ALERTS{alertstate=\"firing\", namespace=\"solidarytech\"}) or vector(0)", "legendFormat": "Firing", "refId": "A" }
      ]
    },
    {
      "title": "Uptime (%)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0.95,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.99 }, { "color": "green", "value": 0.999 } ] }
        }
      },
      "targets": [
        { "expr": "avg(avg_over_time(up{namespace=\"solidarytech\"}[24h]))", "legendFormat": "Uptime 24h", "refId": "A" }
      ]
    },
    {
      "title": "Detalhes dos Alertas Ativos",
      "type": "table",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 5 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "orange", "value": null } ] },
          "custom": { "align": "left" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "severity" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "mappings", "value": [ { "type": "value", "options": { "critical": { "color": "red", "text": "CRITICAL" }, "warning": { "color": "orange", "text": "WARNING" } } } ] } ] },
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [ { "id": "custom.hidden", "value": true } ] },
          { "matcher": { "id": "byName", "options": "Time" }, "properties": [ { "id": "custom.hidden", "value": true } ] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        { "expr": "ALERTS{alertstate=\"firing\", namespace=\"solidarytech\"}", "legendFormat": "", "refId": "A", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["alertname", "severity", "pod", "namespace"] } } }
      ]
    },
    {
      "title": "Throughput por Servico (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        }
      },
      "targets": [
        { "expr": "sum(rate(ngo_request_duration_seconds_count[5m]))", "legendFormat": "ngo-service", "refId": "A" },
        { "expr": "sum(rate(donation_request_duration_seconds_count[5m]))", "legendFormat": "donation-service", "refId": "B" },
        { "expr": "sum(rate(volunteer_request_duration_seconds_count[5m]))", "legendFormat": "volunteer-service", "refId": "C" }
      ]
    },
    {
      "title": "Error Rate por Servico (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "thresholdsStyle": { "mode": "line" } },
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        }
      },
      "targets": [
        { "expr": "(sum(rate(ngo_errors_total[5m])) / sum(rate(ngo_request_duration_seconds_count[5m]))) * 100", "legendFormat": "ngo-service", "refId": "A" },
        { "expr": "(sum(rate(donation_errors_total[5m])) / sum(rate(donation_request_duration_seconds_count[5m]))) * 100", "legendFormat": "donation-service", "refId": "B" },
        { "expr": "(sum(rate(volunteer_errors_total[5m])) / sum(rate(volunteer_request_duration_seconds_count[5m]))) * 100", "legendFormat": "volunteer-service", "refId": "C" }
      ]
    },
    {
      "title": "Latencia P99 por Servico",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 2, "showPoints": "never", "thresholdsStyle": { "mode": "line" } },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.5 } ] }
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(ngo_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "ngo-service P99", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum(rate(donation_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "donation-service P99", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(volunteer_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "volunteer-service P99", "refId": "C" }
      ]
    },
    {
      "title": "Replicas Desejadas vs Prontas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "lineWidth": 1, "showPoints": "never" },
          "unit": "short"
        }
      },
      "targets": [
        { "expr": "kube_deployment_spec_replicas{namespace=\"solidarytech\"}", "legendFormat": "{{ deployment }} desired", "refId": "A" },
        { "expr": "kube_deployment_status_replicas_ready{namespace=\"solidarytech\"}", "legendFormat": "{{ deployment }} ready", "refId": "B" }
      ]
    },
    {
      "title": "CPU por Pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" },
          "unit": "short"
        }
      },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}[5m])) by (pod)", "legendFormat": "{{ pod }}", "refId": "A" }
      ]
    },
    {
      "title": "Memoria por Pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never" },
          "unit": "bytes"
        }
      },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{namespace=\"solidarytech\", container!=\"\", container!=\"POD\"}) by (pod)", "legendFormat": "{{ pod }}", "refId": "A" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["solidarytech", "overview", "executive"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Platform Overview - SolidaryTech",
  "uid": "solidarytech-platform-overview",
  "version": 1
}
