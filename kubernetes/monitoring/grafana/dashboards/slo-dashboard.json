{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "SLO/SLI Tracking - Donation Service (SolidaryTech)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Regiao Ativa",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 0 },
      "datasource": "Prometheus",
      "description": "us-east-1 = Producao | us-west-2 = DR",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [
            { "type": "value", "options": { "us-east-1": { "text": "PROD", "color": "green" } } },
            { "type": "value", "options": { "us-west-2": { "text": "DR", "color": "orange" } } }
          ]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "expr": "topk(1, count by (topology_kubernetes_io_region) (up{namespace=\"solidarytech\"} == 1))", "legendFormat": "{{ topology_kubernetes_io_region }}", "refId": "A" }
      ]
    },
    {
      "title": "SLI: Latency (p99 < 500ms) - Target SLO: 99.9%",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(donation_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "title": "SLI: Error Rate (< 0.1%) - Target SLO: 99.9%",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(\n  sum(rate(donation_errors_total[5m]))\n  /\n  sum(rate(donation_request_duration_seconds_count[5m]))\n) * 100",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "SLO Compliance - Latency (30-day rolling)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.995 },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(\n  sum(rate(donation_request_duration_seconds_count{le=\"0.5\"}[30d]))\n  /\n  sum(rate(donation_request_duration_seconds_count[30d]))\n)",
          "legendFormat": "Latency SLO",
          "refId": "A"
        }
      ]
    },
    {
      "title": "SLO Compliance - Availability (30-day rolling)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.995 },
              { "color": "yellow", "value": 0.999 },
              { "color": "green", "value": 0.9995 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (\n  sum(rate(donation_errors_total[24h]))\n  /\n  sum(rate(donation_request_duration_seconds_count[24h]))\n)",
          "legendFormat": "Availability SLO",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Budget Burn Rate (1h window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 14.4 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(\n  sum(rate(donation_errors_total[1h]))\n  /\n  sum(rate(donation_request_duration_seconds_count[1h]))\n) / 0.001 * (30 * 24)",
          "legendFormat": "Burn Rate (1h)",
          "refId": "A"
        },
        {
          "expr": "(\n  sum(rate(donation_errors_total[6h]))\n  /\n  sum(rate(donation_request_duration_seconds_count[6h]))\n) / 0.001 * (30 * 24)",
          "legendFormat": "Burn Rate (6h)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "SLO Summary",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(donation_errors_total[24h])) / sum(rate(donation_request_duration_seconds_count[24h])))",
          "legendFormat": "Availability SLI",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "sum(rate(donation_request_duration_seconds_count{le=\"0.5\"}[24h])) / sum(rate(donation_request_duration_seconds_count[24h]))",
          "legendFormat": "Latency SLI (p99 < 500ms)",
          "refId": "B",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["slo", "sli", "solidarytech", "sre"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SLO/SLI Tracking - Donation Service",
  "uid": "solidarytech-slo-tracking",
  "version": 1
}
