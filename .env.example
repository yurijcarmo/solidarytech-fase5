# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# PostgreSQL (local development)
POSTGRES_PASSWORD=localdev123

# AWS (para testes locais com LocalStack - nao precisa alterar)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Grafana (local)
GF_ADMIN_PASSWORD=admin

# Para deploy na AWS Academy, configure:
# AWS_ACCESS_KEY_ID=<copiar do AWS Academy>
# AWS_SECRET_ACCESS_KEY=<copiar do AWS Academy>
# AWS_SESSION_TOKEN=<copiar do AWS Academy>
# AWS_DEFAULT_REGION=us-east-1
